
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read, update, delete: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn(); // Any signed-in user can create their own profile
      allow list: if isAdmin(); // Only admins can list all users
    }
    
    // Admin roles - Read-only for clients
    match /admin_roles/{uid} {
        allow read: if isAdmin();
        allow write: if false; // Roles must be managed from the server/console
    }

    // Publicly readable collections
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      // Any authenticated user can create a product.
      allow create: if isSignedIn();
      // Only admins can update or delete products.
      allow update, delete: if isAdmin();
    }
    
    // User-specific subcollections (Carts)
    match /users/{userId}/carts/{cartId} {
        allow read, write: if isOwner(userId) || isAdmin();

        match /items/{itemId} {
            allow read, write: if isOwner(userId) || isAdmin();
        }
    }
    
    // Orders
    match /orders/{orderId} {
        allow create: if isSignedIn(); // User must be owner of the order data
        allow read, update, delete: if isAdmin() || (resource.data.userId == request.auth.uid);
        allow list: if isAdmin(); // Admins can list all orders

        match /items/{itemId} {
            allow read, write: if isAdmin() || (get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid);
        }
    }
  }
}
