/**
 * # Core Philosophy
 * This ruleset enforces a strict, dual-mode security model. User-specific data
 * (profiles, carts, orders) is protected using an ownership model where access
 * is granted only to the authenticated user corresponding to the data path.
 * Administrative access is managed separately and explicitly through a user's
 * 'role' field, preventing users from elevating their own privileges.
 *
 * # Data Structure
 * The data is structurally segregated to enhance security and performance. All
 * private user data is nested under the `/users/{userId}` path, making ownership
 * checks simple and efficient. Publicly readable data, such as the product
 * catalog (`/products`) and categories (`/categories`), resides in top-level
 * collections.
 *
 * # Key Security Decisions
 * - **Admin Roles via Profile Field**: A user is considered an admin only if
 *   their profile document in the `/users` collection has a 'role' field set
 *   to 'admin', or if their UID matches a hardcoded super-admin UID. This is
 *   more secure than letting users edit their own role, as write access to this
 *   field is restricted.
 * - **Strict User Data Scoping**: All access to data within `/users/{userId}`
 *   and its subcollections is gated by checking if the authenticated user's ID
 *   matches the `{userId}` wildcard in the path. This prevents any user from
 *   accessing another's data.
 * - **Public Catalog**: The `/products` and `/categories` collections are
 *   publicly readable to allow for unauthenticated browsing of the store's
 *   catalog. All write operations (creating products, managing stock) are
 *   strictly limited to administrators.
 * - **No User Listing**: To protect user privacy and prevent data scraping,
 *   listing the entire `/users` collection is disabled for non-admin users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole(userId) {
      // Safely check for document existence before accessing data.
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      // The user with the hardcoded UID is always an admin.
      // Other users can be made admins by setting their role to 'admin' in their user document.
      return (isSignedIn() && getUserRole(request.auth.uid) == 'admin') || request.auth.uid == 'RUl2KGivfaQpj7Fx6dQfQIZeOg12';
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function isExistingAdmin() {
      return isAdmin() && resource != null;
    }

    // -------------------------------------------------------------------------
    // Public Catalog Collections
    // -------------------------------------------------------------------------

    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // User-Specific Data
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // Rules for the user document itself at /users/{userId}
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Allow self-registration as 'customer' OR allow admins to create any user.
      allow create: if (isOwner(userId) && request.resource.data.role == 'customer') || isAdmin();
      // Allow owner to update their own profile (but not change their role), OR allow admin to update anything.
      allow update: if (isExistingOwner(userId) && request.resource.data.role == resource.data.role) || isExistingAdmin();
      allow delete: if isExistingOwner(userId) || isExistingAdmin();

      // Rules for subcollections of /users/{userId}
      match /carts/{cartId} {
        allow get, list, create, update, delete: if isOwner(userId);

        match /cartItems/{cartItemId} {
          allow get, list, create, update, delete: if isOwner(userId);
        }
      }

      match /orders/{orderId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId);
        allow update, delete: if isAdmin();

        match /orderItems/{orderItemId} {
          allow get, list: if isOwner(userId) || isAdmin();
          // Order items should be immutable for clients after creation.
          allow create, update, delete: if false;
        }
      }
    }
  }
}
